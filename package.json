{
  "name": "gearguard",
  "version": "1.0.0",
  "description": "Ultimate Maintenance Tracker - Asset and Maintenance Management System",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/simple-server.js",
    "server-full": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "setup-db": "node scripts/setup-db.js",
    "verify": "node scripts/verify-system.js",
    "production-verify": "node scripts/production-verification.js",
    "system-status": "node scripts/system-status.js",
    "test": "node tests/test-server.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "maintenance",
    "asset-management",
    "tracking",
    "equipment"
  ],
  "author": "GearGuard Team",
  "license": "MIT"
}
